(path of the workflow file in that repository is not known from here; adapt the filename):

    - name: Lanes conformance
      run: |
        git clone --depth 1 https://github.com/YobieBenjamin/safety-governor /tmp/sg
        python3 -m pip install cryptography
        cd /tmp/sg && python3 -m lanes.check --observer "$GITHUB_WORKSPACE/observer"

